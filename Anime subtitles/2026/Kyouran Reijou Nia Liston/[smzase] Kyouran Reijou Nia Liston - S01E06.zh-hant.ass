Comment: 0,0:00:52.66,0:00:52.66,OPJP,,0,0,0,code once,NIA={cache={},version='1.0'} NIA.fmt=string.format function NIA.col(h) return '&H'..h:sub(5,6)..h:sub(3,4)..h:sub(1,2)..'&' end function NIA.mix(a,b,t) local s='';for i=1,5,2 do local x=_G.tonumber(a:sub(i,i+1),16);local y=_G.tonumber(b:sub(i,i+1),16);s=s..string.format('%02X',math.floor(x+(y-x)*t+.5))end;return s end function NIA.chars(s)local o={};for c in _G.unicode.chars(s)do o[#o+1]=c end;return o end function NIA.width(s,font,em,space) local w=0;local cs=NIA.chars(s);for _,c in _G.ipairs(cs)do w=w+(NIA.adv[font][c] or 1)*em+space end;return math.max(0,w-space) end function NIA.path(pts) local s='';for i,p in _G.ipairs(pts)do s=s..(i==1 and 'm ' or ' l ')..NIA.fmt('%.2f %.2f',p[1],p[2])end;return s end function NIA.build(src) local id=_G.tonumber(src.actor:match('%d+'));local jp=src.style=='OPJP';local cfg=NIA.shots[id] local mode=cfg[1];local x=cfg[2];local y=cfg[3]+(jp and 0 or cfg[4]);local maxw=cfg[5] local em=jp and cfg[6] or cfg[7];local space=jp and 2.0 or 1.7 local font=jp and (src.text_stripped:match('^[%w%s%p]+$') and 'latin' or 'jp') or 'cn' local cs=NIA.chars(src.text_stripped);local text=src.text_stripped local width=NIA.width(text,font,em,space) if width>maxw then em=em*maxw/width;space=space*maxw/width;width=NIA.width(text,font,em,space)end local left=x-width/2;local right=x+width/2 local pal=NIA.pal[cfg[8]];local ink=pal[1];local outline=pal[2];local accent=pal[3];local low=pal[4] local fs=em*NIA.metrics[font][1];local gy=y+em*NIA.metrics[font][2] local fn=NIA.metrics[font][3];local duration=src.end_time-src.start_time local out={} local function add(a,b,layer,t,s) a=math.max(0,math.floor(a/10+.5)*10);b=math.min(duration,math.floor(b/10+.5)*10) if b>a then out[#out+1]={a=a,b=b,layer=layer,text='{'..t..'}'..s}end end local function draw(a,b,layer,px,py,c,al,extra,path) add(a,b,layer,NIA.fmt('\\an7\\pos(%.2f,%.2f)\\p1\\bord0\\shad0\\1c%s\\alpha&H%02X&',px,py,NIA.col(c),al)..extra,path) end local function jewel(a,b,px,py,c,r,al) draw(a,b,4,px,py,c,al,'\\blur0.35\\fad(160,140)',NIA.path({{0,-r},{r*.5,0},{0,r},{-r*.5,0},{0,-r}})) end local flourish_y=cfg[3]+cfg[4]/2 if jp then local ww=math.min(width*.78,520);local h=mode=='blood' and 2.2 or 1.25 local path=NIA.path({{-ww/2,-h/2},{-12,-h/2},{-12,h/2},{-ww/2,h/2}})..' '..NIA.path({{12,-h/2},{ww/2,-h/2},{ww/2,h/2},{12,h/2}}) draw(0,duration,3,x,flourish_y,accent,48,NIA.fmt('\\clip(%.1f,%.1f,%.1f,%.1f)\\t(0,430,\\clip(%.1f,%.1f,%.1f,%.1f))\\fad(100,180)',x,flourish_y-8,x,flourish_y+9,x-ww/2-4,flourish_y-8,x+ww/2+4,flourish_y+9),path) jewel(60,duration,x,flourish_y,accent,5,15) if mode=='frame' then for side=-1,1,2 do local fx=x+side*(width/2+24) draw(0,duration,3,fx,y,accent,48,'\\blur0.35\\fad(160,180)',NIA.path({{0,-24},{side*7,-24},{side*7,-17},{side*3,-17},{side*3,17},{side*7,17},{side*7,24},{0,24},{0,22},{side*5,22},{side*5,19},{side*1,19},{side*1,-19},{side*5,-19},{side*5,-22},{0,-22}})) end end end local cursor=left;local n=#cs;local seq=mode=='hook' and 120 or 210 local accent_terms=cfg[9] or '' for i,c in _G.ipairs(cs)do local w=(NIA.adv[font][c] or 1)*em;local cx=cursor+w/2;cursor=cursor+w+space if c~=' ' and c~='　' then local ent=math.floor((i-1)/math.max(1,n-1)*seq/10)*10 local dy=mode=='hook' and 10 or (mode=='blood' and 13 or 8) local hot=accent_terms:find(c,1,true) and c~='！' and c~='!' local color=hot and accent or ink if mode=='lily' then color=NIA.mix('FFFFFF','E6F7F1',(i-1)/math.max(1,n-1))end local bwidth=jp and 1.15 or 1.35 local edge=hot and cfg[8]=='sky' and 'FFF8E7' or outline local base=NIA.fmt('\\an5\\fn%s\\fs%.3f\\b%d\\fsp0\\fscx100\\fscy100\\bord%.2f\\3c%s\\shad0\\q2',fn,fs,font=='latin' and 1 or 0,bwidth,NIA.col(edge)) local motion=NIA.fmt('\\move(%.2f,%.2f,%.2f,%.2f,0,210)\\fad(90,160)',cx,gy+dy,cx,gy) add(ent,duration,8,base..motion..NIA.fmt('\\1a&HFF&\\3c%s\\3a&H%s&\\bord2.8\\blur2.2',NIA.col(outline),cfg[8]=='dark' and '48' or '78'),c) add(ent,duration,10,base..motion..NIA.fmt('\\1c%s\\blur1.9\\t(0,210,\\blur0.35)\\fscx96\\fscy104\\t(0,240,\\fscx100\\fscy100)',NIA.col(color)),c) if jp then add(ent+40,math.min(duration,ent+510),11,base..NIA.fmt('\\pos(%.2f,%.2f)\\bord0\\1c%s\\1a&H55&\\blur0.45\\clip(%.2f,%.2f,%.2f,%.2f)\\fad(120,250)',cx,gy,NIA.col(accent),cx-w/2-3,y+em*.13,cx+w/2+3,y+em*.53),c) end if mode=='blood' then local yy=y+em*.06 add(330,duration,12,base..NIA.fmt('\\pos(%.2f,%.2f)\\bord0.4\\3c%s\\1c%s\\blur0.3\\clip(%.1f,%.1f,%.1f,%.1f)\\t(0,700,\\clip(%.1f,%.1f,%.1f,%.1f))\\fad(70,160)',cx,gy,NIA.col(ink),NIA.col('EF5A85'),left-10,yy,left-10,y+em*.65,left-10,yy,right+10,y+em*.65),c) end if mode=='heart' and hot then for beat=0,2 do local a=310+beat*640 add(a,math.min(duration,a+330),12,base..NIA.fmt('\\pos(%.2f,%.2f)\\bord1.8\\3c%s\\1c%s\\alpha&H70&\\blur1.8\\fscx110\\fscy110\\t(0,330,\\fscx100\\fscy100\\alpha&HFF&)\\fad(30,160)',cx,gy,NIA.col(accent),NIA.col(ink)),c) end end if jp and NIA.beats[id] then for _,beat in _G.ipairs(NIA.beats[id])do local a=beat-src.start_time if a>=0 and a+80<duration then local k=(i%2==0) and 1 or -1 add(a,math.min(duration,a+280),13,base..NIA.fmt('\\move(%.2f,%.2f,%.2f,%.2f,0,260)\\bord0\\1c%s\\alpha&H68&\\blur0.5\\clip(%.1f,%.1f,%.1f,%.1f)\\fad(20,200)',cx+k*6,gy,cx+k*14,gy-5,NIA.col(accent),cx-w/2-20,y-em*.14,cx+w/2+20,y+em*.16),c) end end end if jp and (mode=='blood' or mode=='hook' or mode=='impact') then for band=1,2 do local dx=(band==1 and -10 or 10);local yy=y-em*.28+(band-1)*em*.43 add(ent,ent+180,9,base..NIA.fmt('\\move(%.2f,%.2f,%.2f,%.2f,0,170)\\1c%s\\bord0\\blur0.5\\alpha&H65&\\clip(%.2f,%.2f,%.2f,%.2f)\\fad(25,130)',cx+dx,gy,cx,gy,NIA.col(accent),cx-w/2-16,yy,cx+w/2+16,yy+em*.14),c) end end end end if jp then if mode=='hook' or mode=='impact' or mode=='blood' then local sign=(id%2==0) and -1 or 1 draw(0,330,5,x,flourish_y,accent,70,NIA.fmt('\\blur0.8\\clip(%.1f,%.1f,%.1f,%.1f)\\t(0,140,\\clip(%.1f,%.1f,%.1f,%.1f))\\fad(30,200)',left-35,flourish_y-8,left-35,flourish_y+9,left-35,flouris