Comment: 0,0:02:25.00,0:02:25.00,OPCN,,0,0,0,code once all,function V_Strip(i, left, w) local pad=10; local current_x=left-pad; local seed=math.abs(math.floor(left*100)); local right_edge=left+w+pad; for k=1,i do seed=(1103515245*seed+12345)%2147483648; local slice_w=3+(seed%4); if k==i then local x1=current_x; local x2=current_x+slice_w; if x1>right_edge then x1=right_edge end; if x2>right_edge then x2=right_edge end; return math.floor(x1)..",0,"..math.floor(x2)..","..(meta.res_y or 1080) end; current_x=current_x+slice_w end end; function GenFlicker(mode) local S={}; local is_out=(mode=="out"); local probs; if is_out then probs={1.00,0.90,0.74,0.65,0.58,0.49,0.40,0.30,0.21,0.12,0.12,0.12,0.12} else probs={0.20,0.12,0.12,0.12,0.12,0.21,0.30,0.40,0.49,0.58,0.65,0.74,0.90} end; for i=0,12 do if math.random()<probs[i+1] then S[i]="&H00&" else S[i]="&HFF&" end end; if is_out then S[0]="&H00&" end; S[13]=is_out and "&HFF&" or "&H00&"; local tag="\\alpha"..S[0]; for i=1,13 do tag=tag..string.format("\\t(%d,%d,\\alpha%s)",i*33,i*33+1,S[i]) end; return tag end
