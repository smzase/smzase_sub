Comment: 0,0:00:01.00,0:00:01.02,紬の夏休み - JP,Butterfly Effects Function,0,0,0,code once,function Butterfly(s_time,e_time,aftimg_dur,x_blur,y_blur,acl,...) tags = ""  a = {...} if (j == 1) then t1 = s_time t2 = e_time dur = t2-t1 accel = acl n = #a/2 for i = 1,n*2-1,2 do x[(i+1)/2] = a[i] end for i = 2, n*2,2 do y[i/2] = a[i] end c_t = 0 loop_cont = math.ceil(dur/frame_dur) maxloop(loop_cont) f_t = 1/loop_cont end afterimage_dur = aftimg_dur if (afterimage_dur < 0 ) then afterimage_dur = 0 end   pos_x, pos_y = Bezier(n,x,y,c_t) n_t = c_t + f_t  if (j == maxj) then relayer(10) retime("presyl",t1+dur*(c_t^accel),t1+dur*(c_t^accel)+syl.duration+1500) tags = string.format("\\fad(0,300)\\move(%f,%f,%f,%f)\\frz%d\\fscx%d\\t(0,300,\\fscx%d)\\t(300,700,\\fscx%d)\\t(700,1200,\\fscx%d)\\t(1200,1700,\\fscx%d)\\t(1700,2200,\\fscx%d)",pos_x,pos_y,pos_x,pos_y,math.random(-45,45),20*butterfly_scale*0.01,110*butterfly_scale*0.01,20*butterfly_scale*0.01,110*butterfly_scale*0.01,20*butterfly_scale*0.01,110*butterfly_scale*0.01) else retime("presyl",t1+dur*(c_t^accel),t1+dur*(n_t^accel)+afterimage_dur) tags =  string.format("\\move(%f,%f,%f,%f)\\frz%d\\fscx%d",pos_x,pos_y,pos_x+x_blur,pos_y+y_blur,math.floor(math.deg(math.atan2(pre_pos_x-pos_x,pre_pos_y-pos_y))) ,(math.fmod(math.floor(c_frame/3),2) == 0) and 110*butterfly_scale*0.01 - math.fmod(c_frame,3) * 30*butterfly_scale*0.01 or math.fmod(c_frame,3) * 30*butterfly_scale * 0.01+20*butterfly_scale*0.01) end  t = c_t c_t = n_t pre_pos_x = pos_x pre_pos_y = pos_y c_frame = c_frame + 1 return tags end
Comment: 0,0:00:01.00,0:00:01.00,紬の夏休み - JP,Bezier Function,0,0,0,code once,function Bezier(n,x,y,t) p_x = 0 p_y = 0 for i = 1, n, 1 do p_y = p_y + y[i] * set_temp("bern",bernstein(i-1,n-1,t)) p_x = p_x + x[i] * temp.bern  end return p_x, p_y end
Comment: 0,0:00:01.00,0:00:01.00,紬の夏休み - JP,Bezier Function,0,0,0,code once,function bernstein(i,n,t) return (factk(n) / (factk(i)*factk(n-i))) * (t^i) * ((1-t)^(n-i)) end
Comment: 0,0:00:01.00,0:00:01.00,紬の夏休み - JP,Bezier Function,0,0,0,code once,function factk(n) k = 1 if (n > 1) then for i = 2, n, 1 do k = k * i end end return k end
